generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  password     String
  first_name   String
  last_name    String
  refreshToken String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // --- Relations ---
  tasks        Task[]
  roles        UserRole[] // 🌟 เชื่อมไปยังตารางสิทธิ์ (RBAC)
}

model Task {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  date        DateTime
  isDone      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  category    String? 
  color       String? @default("#f59e0b")
  userId      String
  user        User     @relation(fields: [userId], references: [id])

  attachments Attachment[]
}

model Attachment {
  id String @id @default(uuid())
  url String 
  fileName String?

  taskId Int
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}
// --- 🛡️ ระบบ RBAC (Role-Based Access Control) ---

model Role {
  id          String           @id @default(uuid())
  name        String           @unique // เช่น "ADMIN", "MEMBER", "VIEWER"
  description String?
  
  users       UserRole[]       // เชื่อมไปหา User
  permissions RolePermission[] // เชื่อมไปหา Permission
}

model Permission {
  id    String           @id @default(uuid())
  name  String           @unique // เช่น "task:create", "user:delete"
  roles RolePermission[]
}

// 🔗 ตารางกลางเชื่อม User <-> Role
model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId]) // ใช้คู่ ID เป็น Primary Key
}

// 🔗 ตารางกลางเชื่อม Role <-> Permission
model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}